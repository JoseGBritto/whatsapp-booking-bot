# From Meta for Developers > your app > WhatsApp > API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you choose; paste the same value in the webhook configuration on Meta
WHATSAPP_VERIFY_TOKEN=choose-a-secret-string
# App secret (App settings > Basic). Used to verify that webhooks really come from Meta
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v23.0

# Owner's WhatsApp number in international format without + (receives alerts and can query the agenda)
OWNER_PHONE=5492991234567

# Optional approved template for reminders sent more than 24 h after the customer's last message
REMINDER_TEMPLATE=
REMINDER_TEMPLATE_LANG=es_AR

BUSINESS_FILE=business.json
DB_PATH=data/bookings.sqlite3
